{
  "name": "shopblok-starter",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.23.5 <23 || >=24.22.3 <25",
    "pnpm": ">=12.10.1 <13"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "bootstrap": "node scripts/bootstrap.ts",
    "doctor": "node scripts/doctor.ts",
    "stripe:domains": "node scripts/stripe-domains.ts",
    "r2:cors": "node scripts/r2-cors.ts",
    "stripe:listen": "stripe listen --forward-to localhost:9000/hooks/payment/stripe_stripe --events payment_intent.amount_capturable_updated,payment_intent.succeeded,payment_intent.payment_failed,payment_intent.partially_funded",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "check:workspace": "node scripts/check-workspace.ts",
    "check:keys": "node scripts/check-no-keys.ts",
    "tokens": "node scripts/figma-tokens.ts",
    "thumbnails": "node scripts/thumbnails.ts"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
