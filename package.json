{
  "name": "shopblok-starter",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.22.0 <25",
    "pnpm": ">=12.10.1 <13"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "bootstrap": "node scripts/bootstrap.ts",
    "doctor": "node scripts/doctor.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "check:workspace": "node scripts/check-workspace.ts"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
