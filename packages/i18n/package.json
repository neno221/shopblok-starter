{
  "name": "@shopblok/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Locales, the Intl formatters (money, dates, numbers, country names, ICU messages) and the message catalogs, a module per locale (D43). Exports TypeScript source: no build step (D3).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/format.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "address-formats": "node scripts/address-formats.ts"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.18",
    "@shopblok/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "lib-address": "0.7.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "intl-messageformat": "11.2.15"
  }
}
