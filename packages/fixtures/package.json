{
  "name": "@shopblok/fixtures",
  "version": "0.0.0",
  "private": true,
  "description": "Typed mock data: the seeded market map, the design-system samples and, per locale, commerce fixtures typed by the registry's view models (D41). Exports TypeScript source: no build step (D3).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./markets": "./src/markets.ts",
    "./markets.json": "./src/markets.json",
    "./sync": "./src/sync/types.ts",
    "./sync/documents.json": "./src/sync/documents.json",
    "./email/templates.json": "./src/email/templates.json"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@shopblok/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@shopblok/registry": "workspace:*"
  }
}
