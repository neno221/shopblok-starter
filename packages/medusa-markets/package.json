{
  "name": "@shopblok/medusa-markets",
  "version": "0.0.1",
  "private": true,
  "description": "A Medusa plugin: the market settings Medusa has no field for (which countries are open, their languages, domain and time zone, the primary country and the fallback market), on top of Medusa's own regions and store locales (M4b, D89).",
  "author": "Shopblok",
  "license": "MIT",
  "keywords": [
    "medusa-plugin",
    "medusa-v2"
  ],
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "node scripts/dev.mjs",
    "db:generate": "medusa plugin:db:generate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p src/admin",
    "lint": "eslint .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@shopblok/i18n": "workspace:*"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/eslint-plugin": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/test-utils": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@shopblok/fixtures": "workspace:*",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "jiti": "2.7.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "13.5.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "yalc": "1.0.0-pre.53",
    "zod": "4.2.0"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/test-utils": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@tanstack/react-query": "5.64.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "13.5.0"
  },
  "engines": {
    "node": ">=22.23.4 <25"
  }
}
