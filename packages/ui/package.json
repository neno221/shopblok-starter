{
  "name": "@shopblok/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Presentational components, from tokens up to templates: the atoms (shadcn, ReUI and ours) in src/atoms. Exports TypeScript source: no build step (D3).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./atoms/flag-code": "./src/atoms/flag-code.ts",
    "./atoms/*": "./src/atoms/*.tsx",
    "./primitives/*": "./src/primitives/*.tsx",
    "./molecules/*": "./src/molecules/*.tsx",
    "./organisms/*": "./src/organisms/*.tsx",
    "./providers": "./src/providers.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./globals.css": "./src/styles/globals.css",
    "./tokens": "./src/tokens.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@shopblok/i18n": "workspace:*",
    "@shopblok/registry": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "country-flag-icons": "1.6.20",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.56.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@shopblok/config": "workspace:*",
    "@shopblok/fixtures": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "happy-dom": "21.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.35.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  }
}
