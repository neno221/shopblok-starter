{
  "name": "@shopblok/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Presentational components, from tokens up to templates: the atoms (shadcn, ReUI and ours) in src/atoms. Exports TypeScript source: no build step (D3).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./atoms/*": "./src/atoms/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./globals.css": "./src/styles/globals.css",
    "./tokens": "./src/tokens.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.56.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@shopblok/config": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  }
}
