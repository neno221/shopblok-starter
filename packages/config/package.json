{
  "name": "@shopblok/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Prettier presets. Exports config files only: no build step (D3).",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.nextjs.json": "./tsconfig.nextjs.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./tsconfig.library.json": "./tsconfig.library.json",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/next": "./eslint/next.mjs",
    "./eslint/library": "./eslint/library.mjs",
    "./prettier": "./prettier.config.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.base.json && tsc -p tsconfig.nextjs.json && tsc -p tsconfig.node.json && tsc -p tsconfig.library.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "16.4.0",
    "typescript-eslint": "8.71.1"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
