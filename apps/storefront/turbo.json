{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // `next build` reads the market map from Medusa (`GET /store/markets`, D94: the root layout
      // needs it to prerender; the root `turbo.json` lists MEDUSA_BACKEND_URL and Turborepo's Next.js
      // inference the publishable key) and the CMS from Payload's database, so the build needs
      // PAYLOAD_DATABASE_URL and PAYLOAD_SECRET, which strict mode would drop, and a build against
      // another database must not replay this one's cache. What the two hold can't be hashed: a
      // cached build replays the map it was built with until a request revalidates it (the
      // layout's `cacheLife` is 30 s).
      // `DESIGN_SYSTEM_ENABLED` (D33): the design-system pages are static, so the flag is frozen
      // into the build; it is in the hash so that a build with it is never replayed for one without.
      // `STOREFRONT_PRERENDER_PRODUCTS` (D58, D67): how many product pages `generateStaticParams`
      // returns, so it is frozen into the build too, and strict mode would drop it from `pnpm build`
      // without this line. CI sets it to 4 (T42); T49 is the first code that reads it.
      // `STOREFRONT_LISTING_PAGE_SIZE` (T50): the listing pages' first pages are built with it.
      // `S3_PUBLIC_URL` (M6 D127): R2's public URL, whose host goes into the image settings the
      // build freezes (T95's `remotePatterns`); without it strict mode would drop the value CI's
      // `integrations-live` passes, and `next build` would read the blank one in `.env` (PR 134
      // review, item 2). In the hash, since another URL is another build.
      // `SENTRY_ENVIRONMENT`, `SENTRY_RELEASE` and `SENTRY_TRACES_SAMPLE_RATE` (M6 D125, T96):
      // `next.config.ts` writes them into the bundles, so they are in the hash (the DSN is a
      // `NEXT_PUBLIC_*` name, which Turborepo's Next.js inference hashes already).
      "env": [
        "$TURBO_EXTENDS$",
        "PAYLOAD_*",
        "DESIGN_SYSTEM_ENABLED",
        "STOREFRONT_PRERENDER_PRODUCTS",
        "STOREFRONT_LISTING_PAGE_SIZE",
        "S3_PUBLIC_URL",
        "SENTRY_ENVIRONMENT",
        "SENTRY_RELEASE",
        "SENTRY_TRACES_SAMPLE_RATE"
      ],
      // `STOREFRONT_BUILD_WORKERS` (W6 item 7): how many workers prerender, which changes how fast
      // the build is, not what it builds, so it passes through without entering the hash.
      // `SENTRY_AUTH_TOKEN`, `SENTRY_ORG` and `SENTRY_PROJECT` (T96): only the source maps' upload
      // reads them (they change nothing in the build), and the token is a secret, kept out of the hash.
      "passThroughEnv": ["STOREFRONT_BUILD_WORKERS", "SENTRY_AUTH_TOKEN", "SENTRY_ORG", "SENTRY_PROJECT"]
    },
    "test": {
      // `src/lib/markets/medusa-locales.test.ts` reads Medusa's locale list from the backend's
      // installed `@medusajs/translation`. That package is not in this app's own dependencies, so a
      // bump in the backend changes only the lockfile, and the cached pass must not be replayed.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/pnpm-lock.yaml"]
    }
  }
}
