{
  "name": "@shopblok/storefront",
  "version": "0.0.0",
  "private": true,
  "description": "Next 16.4 storefront with Payload 3.92 embedded (D6).",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:first-load": "node scripts/first-load.ts",
    "payload": "payload",
    "generate:types": "payload generate:types && prettier --config ../../packages/config/prettier.config.mjs --write src/payload-types.ts",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@medusajs/js-sdk": "2.21.2",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@shopblok/fixtures": "workspace:*",
    "@shopblok/i18n": "workspace:*",
    "@shopblok/registry": "workspace:*",
    "@shopblok/ui": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "graphql": "16.14.2",
    "lucide-react": "1.56.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "payload": "3.92.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@shopblok/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
