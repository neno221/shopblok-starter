# Storefront environment. Copy to .env (T13's `pnpm bootstrap` does that from T13 on).
# T09 reads the PAYLOAD_* variables and NEXT_PUBLIC_BASE_URL (payload.config.ts); T12 reads the
# Medusa values through src/lib/env.ts. Next and the `payload` CLI load this file themselves.

# This site's public URL. Payload's serverURL, CORS and CSRF origin, and the address the proxy
# fetches the market map from (/next/markets, T11): never taken from a request's Host header, so
# the server must be able to reach this URL itself. `next build` writes it into the build (every
# NEXT_PUBLIC_* value is), so build with the URL the site will be served from: a build made
# without it is for localhost:8000 wherever it runs.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Payload (T09). The database is the compose stack's Postgres on the D15 host port. In development
# Payload creates a missing database on connect, so a wrong URL creates one on whichever server
# answers; with NODE_ENV=production it fails instead.
PAYLOAD_DATABASE_URL=postgres://postgres:postgres@localhost:15432/payload
# Signs Payload's sessions and API keys. Left empty on purpose: Payload refuses to start without it
# ("missing secret key"), so no copy of this file runs with a shared secret. T13's `pnpm bootstrap`
# generates a random one for .env; by hand, any long random string will do.
PAYLOAD_SECRET=
# Schema changes are saved migrations (D9). `true` turns on Drizzle's dev push, for schema
# experiments only: `payload migrate` then asks before it runs.
PAYLOAD_DB_PUSH=false

# Medusa (T12). The publishable key comes from `print-publishable-key.ts` (T07); T13 fills it in.
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# The design-system pages (T22, D33): /design-system/[locale]/…. They are on in `next dev`; in a
# production build only when this is exactly `true` while `next build` runs. `next.config.ts` writes
# the value into the bundle, so setting it on `next start` (or on a host's runtime) changes nothing:
# set it for the build. Turbo lists it for `build`. Without it every /design-system route answers 404.
# DESIGN_SYSTEM_ENABLED=true

# Medusa's revalidation calls (T49, D58): the subscriber and the ten-minute job POST to
# /api/revalidate with this secret as a bearer token. The same value as apps/backend/.env's;
# `pnpm bootstrap` generates one and writes it to both. Empty refuses every call.
REVALIDATE_SECRET=

# Preview (T59, D74): `/next/preview?secret=…&path=…` turns on Draft Mode for an editor signed in to
# Payload; live preview's frame opens it. Empty turns preview off. `pnpm bootstrap` generates one.
PREVIEW_SECRET=
# Payload's jobs, scheduled publishing among them (T59, D74): `/api/payload-jobs/run` runs them for
# `Authorization: Bearer <this>` or a signed-in admin. In `next dev` the storefront calls it every
# minute with this secret (instrumentation.ts); in production Vercel Cron does (M7). Empty: only an
# admin can run jobs, so nothing scheduled is published in development. `pnpm bootstrap` generates one.
CRON_SECRET=

# How many product pages `next build` renders (D58): the first N published handles in handle
# order; the rest render on their first request. Read while building only (turbo lists it). 0, or
# no MEDUSA_BACKEND_URL, renders one placeholder that answers 404.
# STOREFRONT_PRERENDER_PRODUCTS=500

# Products per listing page (T50, D59): 1 to 48. The build renders each listing's first page with
# it and `next start` the others, so both must see the same value.
# STOREFRONT_LISTING_PAGE_SIZE=24

# How many workers `next build` prerenders with (W6 item 7): the logical processors less one, at
# most 3. More put more load on Postgres (each worker has its own Payload pool, 5 connections while
# building) and on Medusa, which `medusa develop` on a PC with many threads could not answer in
# time at 11. Speed only, not output.
# STOREFRONT_BUILD_WORKERS=3

# ---------------------------------------------------------------------------------------------
# Integrations (M6, SPEC §10 and §15). Each one turns on only when its keys are set, and with them
# empty the shop runs as it did before M6 (D114): `pnpm run doctor` lists which are live. Test keys
# only outside production (D115): doctor refuses a live Stripe key there. Never commit a key: CI's
# `pnpm check:keys` fails on one. SETUP.md, "Turning on an integration", says where each comes from.
# Every NEXT_PUBLIC_* value is written into the build: set it before `next build`.

# Stripe (D117): the Payment Element in the checkout and the account's saved cards. The test
# publishable key (pk_test_…). Empty: the checkout offers the system payment ("Pay later").
NEXT_PUBLIC_STRIPE_KEY=

# Resend (D121, D122): Payload's e-mails (form e-mails, the newsletter's confirmation). The
# newsletter's confirmed addresses go to the Resend segment RESEND_NEWSLETTER_SEGMENT_ID; without it
# they are kept as form submissions.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_NEWSLETTER_SEGMENT_ID=
# Without a Resend key, Payload sends its e-mails to Mailpit (the compose stack's inbox,
# http://localhost:8025). Not secrets: the local defaults.
SMTP_HOST=localhost
SMTP_PORT=1025

# PostHog (D124): loaded only after the visitor's analytics consent, through this site's /ingest.
# The host is the EU one when blank.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry (D125): the browser's and the server's errors. Empty: not initialised. The last three only
# upload the source maps while building.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cloudflare R2 through its S3 API (D127): Payload's media, uploaded from the admin straight to
# S3_BUCKET and served from S3_PUBLIC_URL (whose host `next build` writes into the image settings).
# Empty: the local media folder (not on Vercel, whose disk is read-only).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
