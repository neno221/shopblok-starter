# Storefront environment. Copy to .env.local (T13's `pnpm bootstrap` does that from T13 on).
# Nothing reads these yet: T08 is a shell with no backend calls. T09 reads NEXT_PUBLIC_BASE_URL
# (Payload's serverURL), T12 reads the Medusa values through src/lib/env.ts.

# This site's public URL.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Medusa (T12). The publishable key comes from `print-publishable-key.ts` (T07); T13 fills it in.
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
