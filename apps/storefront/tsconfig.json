{
  "extends": "@shopblok/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "paths": {
      "@payload-config": ["./src/payload.config.ts"],
      "@shopblok/ui/atoms": ["../../packages/ui/src/atoms"],
      "@shopblok/ui/atoms/*": ["../../packages/ui/src/atoms/*"],
      "@shopblok/ui/primitives": ["../../packages/ui/src/primitives"],
      "@shopblok/ui/primitives/*": ["../../packages/ui/src/primitives/*"],
      "@shopblok/ui/molecules": ["../../packages/ui/src/molecules"],
      "@shopblok/ui/molecules/*": ["../../packages/ui/src/molecules/*"],
      "@shopblok/ui/organisms": ["../../packages/ui/src/organisms"],
      "@shopblok/ui/organisms/*": ["../../packages/ui/src/organisms/*"],
      "@shopblok/ui/lib": ["../../packages/ui/src/lib"],
      "@shopblok/ui/lib/*": ["../../packages/ui/src/lib/*"],
      "@shopblok/ui/hooks": ["../../packages/ui/src/hooks"],
      "@shopblok/ui/hooks/*": ["../../packages/ui/src/hooks/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "src/migrations"]
}
