# Read by `loadEnv("test")` in jest.config.js, before `.env`. dotenv never overrides a variable that
# is already set (even to nothing), so these win over a developer's `.env`; only the shell wins over
# this file (set `DB_PORT` there if you moved Postgres with `POSTGRES_PORT`). Dev-only values, the
# same as `.env.example` and the compose stack (infra/README.md).

# The integration-test runner creates its own temporary databases on the compose Postgres
# (`DB_HOST` defaults to localhost).
DB_PORT=15432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Blank: keep the event bus in memory. `.env` points REDIS_URL at the dev stack, whose queues a
# running dev server shares.
REDIS_URL=

# The Medusa → Payload sync stays off in tests (T60): `payload-sync.spec.ts` sets both for its fake
# Payload. Blank here wins over `.env`, where bootstrap writes the real ones.
PAYLOAD_SERVER_URL=
PAYLOAD_API_KEY=
