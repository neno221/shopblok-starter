# Read by `loadEnv("test")` in jest.config.js, before `.env`. dotenv never overrides a variable that
# is already set (even to nothing), so these win over a developer's `.env`. Dev-only values, the
# same as `.env.example` and the compose stack (infra/README.md).

# The integration-test runner creates its own temporary databases on the compose Postgres.
DB_HOST=localhost
DB_PORT=15432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Blank: keep the event bus in memory. `.env` points REDIS_URL at the dev stack, whose queues a
# running dev server shares.
REDIS_URL=
