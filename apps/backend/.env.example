# Medusa backend environment. Copy to .env (T13's `pnpm bootstrap` does that and fills the secrets).
# Host ports follow decision D15: Postgres 15432, Redis 6380, Meilisearch 7701 (infra/README.md).

# Core
DATABASE_URL=postgres://postgres:postgres@localhost:15432/medusa
# Empty on purpose: development and test warn and use Medusa's default secret (a plain copy still
# boots, via getSecret in src/config/config.ts); production and any other NODE_ENV refuse to start.
# A `supersecret` placeholder would be accepted there and is public.
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# Infra. Redis is used since T06, Meilisearch since T94; T13 and T14 read the ports from these URLs.
REDIS_URL=redis://localhost:6380
# Medusa's caching module on that Redis (M7 D149, T112): the Store API's reads are cached and cleared
# on every change. T112's check (`e2e/cache-freshness.spec.ts`) found no stale answer in 40 changes,
# so it is on here, in CI and on staging. Needs REDIS_URL; blank or false turns it off (doctor says so).
MEDUSA_FF_CACHING=true
# With both set, /store/search runs on Meilisearch; blank either one and it runs on Postgres (T94).
MEILISEARCH_HOST=http://localhost:7701
# The fixed dev master key from infra/docker-compose.yml. Not a secret.
MEILISEARCH_API_KEY=shopblok-local-dev-master-key
# Optional: a prefix for this store's index names (lowercase letters, digits, _), so several stores
# or a test run can share one Meilisearch. Changing it builds a new index on the next db:migrate.
MEILISEARCH_INDEX_PREFIX=

# CMS link (SPEC section 15). T13 fills PAYLOAD_API_KEY and REVALIDATE_SECRET.
# STOREFRONT_URL is also the base of the links in customer e-mails (T44): the verification link
# ({STOREFRONT_URL}{market prefix}/verify?code=...) and the password reset link. It must be an
# http(s) URL; without one the subscribers log an error and send nothing.
STOREFRONT_URL=http://localhost:8000
PAYLOAD_SERVER_URL=http://localhost:8000
PAYLOAD_USER_COLLECTION=integrations
PAYLOAD_API_KEY=
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------------------------
# Integrations (M6, SPEC §10 and §15). Each one turns on only when its keys are set, and with them
# empty the shop runs as it did before M6 (D114): `pnpm run doctor` lists which are live. Test keys
# only outside production (D115): doctor refuses a live Stripe key there. Never commit a key: CI's
# `pnpm check:keys` fails on one. SETUP.md, "Turning on an integration", says where each comes from.

# Stripe (D117): the payment provider pp_stripe_stripe, on every region. With both empty the
# checkout takes the system payment ("Pay later"). STRIPE_API_KEY is the test secret key (sk_test_…);
# the webhook secret comes from `stripe listen` on a PC, or the Dashboard's endpoint in production.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (D121): Medusa's e-mails (verification, password reset, orders). Empty: the links are
# printed in this app's console (notification-local), where the e2e suites read them. The sender is
# onboarding@resend.dev until a domain of yours is verified with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostHog (D124, T97): the server's events (order placed, canceled, cart created), sent only for a
# cart or order that carries the visitor's analytics consent. The project API key (phc_…, the same
# as the storefront's NEXT_PUBLIC_POSTHOG_KEY), never a personal key (phx_…). Empty: analytics-local,
# which sends nothing. POSTHOG_HOST is optional: blank is the EU host, https://eu.i.posthog.com.
POSTHOG_EVENTS_API_KEY=
POSTHOG_HOST=

# Sentry (D125, T96): this app's errors (a 5xx, a failed subscriber, workflow step or job), scrubbed.
# Empty: not initialised, and Sentry's SDK is never loaded. The sample rate of traces is 0 (none)
# when blank. The release is SENTRY_RELEASE, else the commit (Railway's or GitHub Actions').
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_RELEASE=

# Cloudflare R2 through its S3 API (D127): product pictures in S3_BUCKET, served from S3_PUBLIC_URL;
# CSV imports and exports in S3_PRIVATE_BUCKET, which has no public access. Empty: file-local
# (development only). S3_REGION is `auto` for R2 when blank.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---------------------------------------------------------------------------------------------
# Deployment (M7). Named in T105; the task in brackets makes each one do something. Leave them all
# empty in development: DEPLOY.md says what staging and production set.

# Which deployment this is (D133): `staging` or `production`, unset in development, tests and CI.
# Staging runs with NODE_ENV=production, so only this tells it from the live shop: staging refuses
# a live Stripe key and lets the demo catalog run once with SEED_DEMO=true. Any other value stops
# the start. (T105)
DEPLOY_ENV=
# Signs the storefront's calls to Medusa's rate-limit route and the visitor's address they carry
# (D142); the same value as the storefront's. (T108)
STOREFRONT_SIGNING_SECRET=
# The secrets' fingerprints, written only by `pnpm staging:secrets` (D134): never set it by hand. (T114)
SHOPBLOK_SECRET_FINGERPRINTS=
# Staging's first deployment only (D136): the staff account Medusa's seed invites by e-mail. (T111)
SEED_ADMIN_EMAIL=
# Medusa Admin's two-factor sign-in (D140): the key its codes' secrets are encrypted with. (T109)
AUTH_MFA_ENCRYPTION_KEY=
# The storefront's CRON_SECRET (D148): Medusa's worker calls Payload's /api/payload-jobs/run every
# minute with it, so scheduled publishing runs without Vercel Cron. The same value as the
# storefront's. (T111)
CRON_SECRET=
