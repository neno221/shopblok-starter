# Medusa backend environment. Copy to .env (T13's `pnpm bootstrap` does that and fills the secrets).
# Host ports follow decision D15: Postgres 15432, Redis 6380, Meilisearch 7701 (infra/README.md).

# Core
DATABASE_URL=postgres://postgres:postgres@localhost:15432/medusa
# Empty on purpose: development and test warn and use Medusa's default secret (a plain copy still
# boots, via getSecret in src/config/config.ts); production and any other NODE_ENV refuse to start.
# A `supersecret` placeholder would be accepted there and is public.
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# Infra. Redis and Meilisearch are used from T06 and M6; T13 and T14 read the ports from these URLs.
REDIS_URL=redis://localhost:6380
MEILISEARCH_HOST=http://localhost:7701
# The fixed dev master key from infra/docker-compose.yml. Not a secret.
MEILISEARCH_API_KEY=shopblok-local-dev-master-key

# Feature flags
MEDUSA_FF_TRANSLATION=true

# CMS link (SPEC section 15). T13 fills PAYLOAD_API_KEY and REVALIDATE_SECRET.
STOREFRONT_URL=http://localhost:8000
PAYLOAD_SERVER_URL=http://localhost:8000
PAYLOAD_USER_COLLECTION=integrations
PAYLOAD_API_KEY=
REVALIDATE_SECRET=
