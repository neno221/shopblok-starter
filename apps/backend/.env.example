# Medusa backend environment. Copy to .env (T13's `pnpm bootstrap` does that and fills the secrets).
# Host ports follow decision D15: Postgres 15432, Redis 6380, Meilisearch 7701 (infra/README.md).

# Core
DATABASE_URL=postgres://postgres:postgres@localhost:15432/medusa
# Empty on purpose: development and test warn and use Medusa's default secret (a plain copy still
# boots, via getSecret in src/config/config.ts); production and any other NODE_ENV refuse to start.
# A `supersecret` placeholder would be accepted there and is public.
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# Infra. Redis and Meilisearch are used from T06 and M6; T13 and T14 read the ports from these URLs.
REDIS_URL=redis://localhost:6380
MEILISEARCH_HOST=http://localhost:7701
# The fixed dev master key from infra/docker-compose.yml. Not a secret.
MEILISEARCH_API_KEY=shopblok-local-dev-master-key

# Feature flags
MEDUSA_FF_TRANSLATION=true

# CMS link (SPEC section 15). T13 fills PAYLOAD_API_KEY and REVALIDATE_SECRET.
# STOREFRONT_URL is also the base of the links in customer e-mails (T44): the verification link
# ({STOREFRONT_URL}{market prefix}/verify?code=...) and the password reset link. It must be an
# http(s) URL; without one the subscribers log an error and send nothing.
STOREFRONT_URL=http://localhost:8000
PAYLOAD_SERVER_URL=http://localhost:8000
PAYLOAD_USER_COLLECTION=integrations
PAYLOAD_API_KEY=
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------------------------
# Integrations (M6, SPEC §10 and §15). Each one turns on only when its keys are set, and with them
# empty the shop runs as it did before M6 (D114): `pnpm run doctor` lists which are live. Test keys
# only outside production (D115): doctor refuses a live Stripe key there. Never commit a key: CI's
# `pnpm check:keys` fails on one. SETUP.md, "Turning on an integration", says where each comes from.

# Stripe (D117): the payment provider pp_stripe_stripe, on every region. With both empty the
# checkout takes the system payment ("Pay later"). STRIPE_API_KEY is the test secret key (sk_test_…);
# the webhook secret comes from `stripe listen` on a PC, or the Dashboard's endpoint in production.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (D121): Medusa's e-mails (verification, password reset, orders). Empty: the links are
# printed in this app's console (notification-local), where the e2e suites read them. The sender is
# onboarding@resend.dev until a domain of yours is verified with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostHog (D124): the server's events (order placed, canceled, cart created), sent only for a cart
# that carries the visitor's analytics consent. Empty: analytics-local. The EU host is
# https://eu.i.posthog.com.
POSTHOG_EVENTS_API_KEY=
POSTHOG_HOST=

# Sentry (D125, T96): this app's errors (a 5xx, a failed subscriber, workflow step or job), scrubbed.
# Empty: not initialised, and Sentry's SDK is never loaded. The sample rate of traces is 0 (none)
# when blank. The release is SENTRY_RELEASE, else the commit (Railway's or GitHub Actions').
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_RELEASE=

# Cloudflare R2 through its S3 API (D127): product pictures in S3_BUCKET, served from S3_PUBLIC_URL;
# CSV imports and exports in S3_PRIVATE_BUCKET, which has no public access. Empty: file-local
# (development only). S3_REGION is `auto` for R2 when blank.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
