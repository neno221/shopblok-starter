{
  "$schema": "https://turborepo.dev/schema.json",
  // Medusa's telemetry opt-out. Strict mode drops it from every `turbo run` task, so `medusa start`
  // (spawned by `medusa develop`) queues CLI_START events despite the variable in the shell (T15).
  // Global rather than on `dev`: a task added later that runs a Medusa command would lose the
  // opt-out unnoticed.
  // `SWC_NATIVE_BINDING_CACHE`: where `@swc/core` unpacks its native binary. A local Claude Code
  // session in the Windows desktop app must set it (SETUP.md, "Windows notes"), because the
  // packaged app redirects `AppData\Local` and swc refuses that folder; strict mode dropped it, so
  // `medusa build` failed under `pnpm build` there (W2, finding 5). Passthrough: in no hash.
  "globalPassThroughEnv": ["MEDUSA_DISABLE_TELEMETRY", "SWC_NATIVE_BINDING_CACHE"],
  "tasks": {
    "build": {
      // `transit`: a source-only package (no build script, D3: packages/ui's globals.css,
      // @shopblok/i18n…) has no `build` hash of its own, so without it an edit there could replay
      // a cached storefront build. The transit node puts its files in the build's hash.
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["MEDUSA_BACKEND_URL", "STOREFRONT_URL"],
      "outputs": [".next/**", "!.next/cache/**", ".medusa/server/**", "dist/**"]
    },
    "dev": {
      // `^build`: the backend loads the markets plugin from its `.medusa/server`, which only a
      // build makes (T73, D89). Without it a fresh clone starts Medusa without the plugin's module.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      // Strict mode drops variables the task doesn't list, so `PAYLOAD_DB_PUSH=true pnpm dev`, a
      // `PAYLOAD_SECRET` or a `MEDUSA_BACKEND_URL` from the shell would never reach `next dev`, nor
      // `STOREFRONT_LISTING_PAGE_SIZE` (W5; T58 added `STOREFRONT_*`, which also hands a shell's
      // `STOREFRONT_URL` to the backend's `medusa develop`, over its `.env`).
      // (`NEXT_PUBLIC_*` is listed by Turborepo's Next.js inference.) A `.env` file worked already:
      // Next loads it itself.
      "passThroughEnv": ["PAYLOAD_*", "MEDUSA_BACKEND_URL", "STOREFRONT_*"]
    },
    // The plugin's own `dev` (`medusa plugin:develop`) first deletes `.medusa/server` and builds it
    // again, as `plugin:build` does. With only `^build` on `dev` they ran at the same time on the
    // same folder: a failed or half-written build (cached as the build's outputs), or a backend
    // that started in between and skipped the module (PR 105 review, item 1). So it runs after its
    // own `build`, and the backend's `dev` (which waits for that `build` too) cannot overlap it.
    "@shopblok/medusa-markets#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PAYLOAD_*", "MEDUSA_BACKEND_URL", "STOREFRONT_*"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    // The backend's tests and type check load the markets plugin, which exists only once built
    // (T73, D89). This package is the one exception to D3 ("no build step in packages/*").
    "@shopblok/backend#typecheck": {
      "dependsOn": ["transit", "@shopblok/medusa-markets#build"]
    },
    "@shopblok/backend#lint": {
      "dependsOn": ["transit", "@shopblok/medusa-markets#build"]
    },
    "@shopblok/backend#test": {
      "dependsOn": ["transit", "@shopblok/medusa-markets#build"]
    },
    "db:migrate": {
      "cache": false
    },
    "seed": {
      "cache": false
    }
  }
}
