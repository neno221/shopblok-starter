{
  "$schema": "https://turborepo.dev/schema.json",
  // Medusa's telemetry opt-out. Strict mode drops it from every `turbo run` task, and without it
  // `medusa start` (which `medusa develop` spawns) queues CLI_START events even with the variable set
  // in the shell (T15). It is an opt-out, so it is global rather than on `dev` alone: a task added
  // later that runs a Medusa command would otherwise opt the developer back in without a sign.
  "globalPassThroughEnv": ["MEDUSA_DISABLE_TELEMETRY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["MEDUSA_BACKEND_URL", "STOREFRONT_URL"],
      "outputs": [".next/**", "!.next/cache/**", ".medusa/server/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // Strict mode drops variables the task doesn't list, so `PAYLOAD_DB_PUSH=true pnpm dev`, a
      // `PAYLOAD_SECRET` or a `MEDUSA_BACKEND_URL` from the shell would never reach `next dev`.
      // (`NEXT_PUBLIC_*` is listed by Turborepo's Next.js inference.) A `.env` file worked already:
      // Next loads it itself.
      "passThroughEnv": ["PAYLOAD_*", "MEDUSA_BACKEND_URL"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "db:migrate": {
      "cache": false
    },
    "seed": {
      "cache": false
    }
  }
}
