{
  "$schema": "https://turborepo.dev/schema.json",
  // Medusa's telemetry opt-out. Strict mode drops it from every `turbo run` task, so `medusa start`
  // (spawned by `medusa develop`) queues CLI_START events despite the variable in the shell (T15).
  // Global rather than on `dev`: a task added later that runs a Medusa command would lose the
  // opt-out unnoticed.
  // `SWC_NATIVE_BINDING_CACHE`: where `@swc/core` unpacks its native binary. A local Claude Code
  // session in the Windows desktop app must set it (SETUP.md, "Windows notes"), because the
  // packaged app redirects `AppData\Local` and swc refuses that folder; strict mode dropped it, so
  // `medusa build` failed under `pnpm build` there (W2, finding 5). Passthrough: in no hash.
  "globalPassThroughEnv": ["MEDUSA_DISABLE_TELEMETRY", "SWC_NATIVE_BINDING_CACHE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["MEDUSA_BACKEND_URL", "STOREFRONT_URL"],
      "outputs": [".next/**", "!.next/cache/**", ".medusa/server/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // Strict mode drops variables the task doesn't list, so `PAYLOAD_DB_PUSH=true pnpm dev`, a
      // `PAYLOAD_SECRET` or a `MEDUSA_BACKEND_URL` from the shell would never reach `next dev`.
      // (`NEXT_PUBLIC_*` is listed by Turborepo's Next.js inference.) A `.env` file worked already:
      // Next loads it itself.
      "passThroughEnv": ["PAYLOAD_*", "MEDUSA_BACKEND_URL"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "db:migrate": {
      "cache": false
    },
    "seed": {
      "cache": false
    }
  }
}
